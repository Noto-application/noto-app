{
  // Редактор должен использовать TypeScript из node_modules (5.9.3), а не
  // встроенный в VSCode — иначе подсветка расходится с тем, что проверяет CI.
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  "eslint.workingDirectories": [{ "mode": "auto" }],

  // Jest живёт только в apps/api и apps/collab. Явные virtualFolders отключают
  // авто-детект (иначе расширение находит несколько кандидатов в монорепе и
  // сканирует мусорные .next/*). apps/web на Vitest — сюда не входит.
  "jest.virtualFolders": [
    { "name": "api", "rootPath": "apps/api" },
    { "name": "collab", "rootPath": "apps/collab" }
  ],

  "files.eol": "\n",
  "files.watcherExclude": {
    "**/.next/**": true,
    "**/dist/**": true,
    "**/.turbo/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.turbo": true,
    "**/pnpm-lock.yaml": true
  }
}
