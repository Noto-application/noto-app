NODE_ENV=production
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=https://noto-dev.185-31-243-90.sslip.io
DATABASE_URL=postgresql://noto:CHANGE_ME@postgres:5432/noto
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_REFRESH_GRACE_TTL=10s
COLLAB_SHARED_SECRET=CHANGE_ME_SHARED_WITH_COLLAB

# Yandex Object Storage (S3-compatible), production bucket (ADR-017).
# Use a bucket distinct from local development and configure its CORS for the
# production app origin. Set production credentials on the server in
# runtime/api.env; do not commit real values.
STORAGE_BUCKET=CHANGE_ME_PROD_BUCKET
STORAGE_REGION=ru-central1
STORAGE_ENDPOINT=https://storage.yandexcloud.net
# Use credentials scoped to the production bucket.
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
