{
  email {$ACME_EMAIL}
}

{$NOTO_PUBLIC_HOST} {
  encode zstd gzip

  # Internal service-to-service API is deliberately never exposed by Caddy.
  @internal path /internal/*
  respond @internal 404

  handle /api/* {
    reverse_proxy api:4000
  }

  handle /collab* {
    reverse_proxy collab:5555
  }

  handle {
    reverse_proxy web:3000
  }
}
