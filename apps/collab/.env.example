# Скопировать в apps/collab/.env перед запуском:
#   cp apps/collab/.env.example apps/collab/.env

# Порт Hocuspocus WS-сервера. Caddy проксирует сюда путь /collab (порт 5555 — 5000 на macOS занимает AirPlay).
PORT=5555

# Сервисный секрет — ОБЩИЙ с apps/api (COLLAB_SHARED_SECRET там же).
# Пустой запрещает старт сервиса.
COLLAB_SHARED_SECRET=dev-collab-secret-change-me

# Разрешённые Origin WS-подключения (через запятую), точное совпадение.
# Единый origin фронта за Caddy.
COLLAB_ALLOWED_ORIGINS=http://localhost:8080

# Базовый URL API для internal-авторизации. В dev — Caddy или прямой порт API;
# endpoint /internal/collab/authorize наружу не роутится, зовётся отсюда.
API_INTERNAL_URL=http://localhost:4000
