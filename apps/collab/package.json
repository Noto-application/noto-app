{
  "name": "@noto/collab",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node --env-file=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start:production": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@hocuspocus/server": "2.15.3",
    "@noto/shared": "workspace:*",
    "@ts-rest/core": "3.53.0-rc.1",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "26.1.1",
    "jest": "30.4.2",
    "ts-jest": "29.4.11",
    "tsx": "4.20.3",
    "typescript": "5.9.3"
  }
}
