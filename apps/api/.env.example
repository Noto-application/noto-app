# Скопировать в apps/api/.env перед первым запуском:
#   cp apps/api/.env.example apps/api/.env

NODE_ENV=development
PORT=4000

# Origin фронтенда для CORS. Запросы идут с credentials (ADR-003), поэтому
# wildcard "*" недопустим — только явный origin.
CORS_ORIGIN=http://localhost:3000

# Значения совпадают с docker-compose.yml в корне репозитория.
DATABASE_URL=postgresql://noto:noto@localhost:5433/noto_dev
REDIS_URL=redis://localhost:6380

# JWT. В dev можно любые непустые строки; в production — сильные случайные секреты
# (например `openssl rand -base64 48`). Access короткий, refresh длинный.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
