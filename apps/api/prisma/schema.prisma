// Prisma schema — источник правды для структуры БД.
// Документация: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Пользователь. Профиль: опциональный username (issue #124).
/// Роли и связи добавляются отдельными миграциями по мере надобности.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships  ProjectMember[]
  createdPages Page[]          @relation("PageAuthor")

  @@map("users")
}

/// Роли участника проекта (ADR-011). Иерархия: owner > editor > viewer.
enum ProjectRole {
  owner
  editor
  viewer
}

/// Проект — единица доступа (ADR-011). Владелец выражен через ProjectMember
/// с role=owner, отдельного ownerId нет. Удаление мягкое: deletedAt.
model Project {
  id        String          @id @default(uuid())
  name      String
  members   ProjectMember[]
  pages     Page[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?

  calendarCreateRequests CalendarCreateRequest[]

  @@map("projects")
}

/// Страница внутри проекта (спека apps/api/src/pages/pages.spec.md). Дерево —
/// через parentId (self-relation). Контент — BlockNote-док (Json). Права
/// наследуются от проекта, своей записи доступа у страницы нет. Удаление мягкое.
/// Режим редактора страницы (#109/#110). `rest` — контент в поле `content`
/// (REST-автосейв); `collab` — тело живёт в Yjs (PageCollabState), `content`
/// больше не источник истины. Раз переведённая в collab страница не возвращается.
enum EditorMode {
  rest
  collab

  @@map("editor_mode")
}

model Page {
  id          String     @id @default(uuid())
  projectId   String
  parentId    String?
  createdById String?
  title       String
  content     Json       @default("[]")
  position    Int        @default(0)
  editorMode  EditorMode @default(rest)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  project               Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent                Page?                  @relation("PageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children              Page[]                 @relation("PageTree")
  // Автор (создатель) — для будущего байлайна при публикации. Не в публичном DTO.
  // При удалении пользователя страница остаётся, автор обнуляется.
  createdBy             User?                  @relation("PageAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  // Снапшот Yjs-состояния для collab-страниц (#109). 1:1, каскад при удалении.
  collabState           PageCollabState?
  // Календарная запись страницы (#134). 1:1, только у датированных страниц.
  calendarEntry         CalendarEntry?
  // Запись идемпотентности create из календаря (#134). Максимум одна на Page.
  calendarCreateRequest CalendarCreateRequest?

  @@index([projectId])
  @@index([parentId])
  @@map("pages")
}

/// Снапшот Yjs-документа страницы (#109). Полное состояние (Y.encodeStateAsUpdate)
/// + монотонная версия — guard от отката запоздавшей записью. 1:1 со страницей.
model PageCollabState {
  pageId    String   @id
  state     Bytes
  version   Int      @default(0)
  updatedAt DateTime @updatedAt
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("page_collab_states")
}

/// Календарная запись страницы (#134; спека apps/api/src/calendar/calendar.spec.md).
/// Отдельная опциональная 1:1 к Page: `pageId` — идентифицирующий FK. `title` и
/// `projectId` не дублируются — выводятся из Page. `date` — date-only
/// (канонический YYYY-MM-DD, без времени и зоны). Запись переживает soft-delete
/// Page (deletedAt): каскад срабатывает только при физическом удалении Page.
model CalendarEntry {
  pageId    String   @id
  date      String   @db.Char(10)
  updatedAt DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([date])
  @@map("calendar_entries")
}

/// Запись идемпотентности create из календаря (#134). Ключ — пара
/// `(projectId, clientRequestId)`: тот же `clientRequestId` в другом проекте —
/// независимый create. Хранит нормализованный fingerprint исходного запроса
/// (`title`, `date`), не зависящий от последующих переименований Page и снятия
/// даты. `pageId` уникален — максимум один request на Page. Каскады — только на
/// физическое удаление Project/Page, чтобы soft-delete их сохранял.
model CalendarCreateRequest {
  id              String   @id @default(uuid())
  projectId       String
  clientRequestId String
  pageId          String   @unique
  title           String
  date            String   @db.Char(10)
  createdAt       DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  page    Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([projectId, clientRequestId])
  @@map("calendar_create_requests")
}

/// Явный грант доступа: (проект, пользователь) → роль. Источник правды по
/// владению и правам (ADR-011).
model ProjectMember {
  projectId String
  userId    String
  role      ProjectRole
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}
