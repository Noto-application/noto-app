    "@noto/shared": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.28",
    "@types/jest": "30.0.0",
    "@types/node": "26.1.1",
    "@types/supertest": "7.2.1",
    "jest": "30.4.2",
    "supertest": "7.2.2",
